# LandConnect Environment Configuration

# Backend Settings
PROJECT_NAME="LandConnect API"
VERSION="1.0.0"
SECRET_KEY="landconnect_super_secret_jwt_key_2026_production_grade"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Default: SQLite with WAL mode. For production PostgreSQL, specify:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/landconnect
DATABASE_URL="sqlite+aiosqlite:///./landconnect.db"

# Storage
UPLOAD_DIR="./uploads"

# Mobile Client API
EXPO_PUBLIC_API_URL="http://localhost:8000/api"
EXPO_PUBLIC_WS_URL="ws://localhost:8000/ws"
